# Copy to .env and adjust.

# First-run admin account. If ADMIN_PASSWORD is empty a random one is printed in the container logs.
ADMIN_USER=admin
ADMIN_PASSWORD=

# The URL agents use to reach this server. It is embedded in the install commands.
# Leave empty to derive it from the browser's address (fine for LAN use).
# With the Caddy/https profile set it to https://<your DOMAIN>.
PUBLIC_URL=

# Host port for the web console + agent endpoint (container listens on 8080)
HOSTPILOT_PORT=8080

# Domain for the optional Caddy HTTPS reverse proxy (docker compose --profile https up -d)
DOMAIN=rmm.example.com

# Set to "false" if the container is exposed directly (no reverse proxy) so clients
# cannot spoof their IP with X-Forwarded-For.
TRUST_PROXY=true
